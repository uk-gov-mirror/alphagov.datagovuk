{% extends "base.jinja" %}

{% from "govuk_frontend_jinja/components/radios/macro.html" import govukRadios -%}
{% from "govuk_frontend_jinja/components/input/macro.html" import govukInput -%}
{% from "govuk_frontend_jinja/components/textarea/macro.html" import govukTextarea -%}
{% from "govuk_frontend_jinja/components/button/macro.html" import govukButton -%}

{% set page_title = "Contact" %}

{% block main %}
  <div class="govuk-width-container datagovuk-width-container govuk-!-margin-top-9">
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-two-thirds">

        <h1 class="govuk-heading-l datagovuk-heading-l">Contact National Data Library</h1>

        <section class="govuk-!-margin-bottom-8">
          <p class="govuk-body datagovuk-body">
            The government Digital Service (GDS) maintains the service behind the National Data Library.
          </p>

          <p class="govuk-body datagovuk-body">The National Data Library service cannot:</p>
          <ul class="govuk-list govuk-list--bullet datagovuk-list datagovuk-body">
            <li>provide personal information or medical records</li>
            <li>combine data from multiple datasets</li>
            <li>host data</li>
          </ul>

          <p class="govuk-body datagovuk-body govuk-!-margin-bottom-8">
            If you are providing feedback or would like to suggest new features or data, please use our feedback form. Otherwise, submit your request through the support form below.
          </p>
        </section>

        <div class="govuk-inset-text datagovuk-inset-text govuk-!-margin-bottom-8">
          <p class="govuk-body datagovuk-body">
            Civil Servant? <a href="#" class="govuk-link datagovuk-link--secondary">Join the National Data Library on Slack</a>
          </p>
        </div>

        <section class="govuk-!-margin-bottom-8">
          <form method="post" novalidate>
            {{ csrf_input }}

            {# djlint:off #}
            {{ govukRadios({
              "name": form.about.html_name,
              "fieldset": {
                "legend": {
                  "text": form.about.label,
                  "classes": "govuk-heading-m datagovuk-heading-m govuk-!-margin-bottom-8",
                  "isPageHeading": false,
                }
              },
              "items": [
                {
                  "value": "whole_website",
                  "text": "The whole website",
                  "checked": form.about.value() == "whole_website",
                  "classes": "datagovuk-form-group"
                },
                {
                  "value": "specific_page",
                  "text": "A specific page",
                  "checked": form.about.value() == "specific_page",
                  "classes": "datagovuk-form-group",
                  "conditional": {
                    "html": govukInput({
                      "label": {"text": form.page_reference.label},
                      "id": form.page_reference.id_for_label,
                      "name": form.page_reference.html_name,
                      "value": form.page_reference.value() or "",
                      "errorMessage": {"text": form.page_reference.errors|join} if form.page_reference.errors else None,
                    })
                  },
                },
              ],
              "errorMessage": {"text": form.about.errors|join} if form.about.errors else None,
              "formGroup": {"classes": "datagovuk-form-group"},
            }) }}

            {# TODO: connect maxlength with calculations #}
            {{ govukTextarea({
              "label": {
                "text": form.details.label,
                "classes": "govuk-heading-m datagovuk-heading-m govuk-!-margin-bottom-4",
              },
              "hint": {"text": "For example if you were searching for something, what did you type into the search box?", "classes": "govuk-!-margin-bottom-8 govuk-body datagovuk-body"},
              "id": form.details.id_for_label,
              "name": form.details.html_name,
              "value": form.details.value() or "",
              "maxlength": 1200,
              "errorMessage": {"text": form.details.errors|join} if form.details.errors else None,
              "formGroup": {
                "classes": "datagovuk-form-group",
              },
            }) }}

            <p class="govuk-hint govuk-body datagovuk-body govuk-!-margin-bottom-8">You have 1200 characters remaining</p>

            <div class="govuk-form-group datagovuk-form-group govuk-!-margin-bottom-8">
              <fieldset class="govuk-fieldset">
                <legend class="govuk-fieldset__legend govuk-heading-m datagovuk-heading-m">
                  If you want a reply (optional)
                </legend>

                <p class="govuk-body datagovuk-body govuk-!-margin-bottom-8">If you'd like us to get back to you, please leave your details below.</p>

                {{ govukInput({
                  "label": {"text": form.name.label, "classes": "govuk-body datagovuk-body"},
                  "id": form.name.id_for_label,
                  "name": form.name.html_name,
                  "value": form.name.value() or "",
                  "errorMessage": {"text": form.name.errors|join} if form.name.errors else None,
                  "formGroup": {"classes": "datagovuk-form-group"},
                }) }}

                {{ govukInput({
                  "label": {"text": form.email.label, "classes": "govuk-body datagovuk-body"},
                  "hint": {"text": "We'll only use this to reply to your message."},
                  "id": form.email.id_for_label,
                  "name": form.email.html_name,
                  "value": form.email.value() or "",
                  "type": "email",
                  "errorMessage": {"text": form.email.errors|join} if form.email.errors else None,
                  "formGroup": {"classes": "datagovuk-form-group"},
                }) }}
              </fieldset>
            </div>

            {{ govukButton({"text": "Send message", "classes": "govuk-button datagovuk-button"}) }}
            {# djlint:on #}
          </form>
        </section>
      </div>
    </div>
  </div>
{% endblock main %}
